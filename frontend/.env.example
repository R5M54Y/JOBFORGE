# JOBFORGE - Environment Variables (Production Template)

# --- REQUIRED ---

# PostgreSQL connection string
# Supports standard DATABASE_URL or Neon/Vercel-specific REMOTEJOBSDB_POSTGRES_URL
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Vercel Cron Security
# Generated secret used to authorize the /api/cron/scrape endpoint
# In Vercel, this is often automatically provided as CRON_SECRET
CRON_SECRET=your_secret_token_here


# --- OPTIONAL ---

# Application Branding
SITE_TITLE=JOBFORGE

# External Verification
# Google Search Console verification token
GOOGLE_SITE_VERIFICATION=

# Environment
NODE_ENV=production
